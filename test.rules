rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ADD this block inside `match /databases/{database}/documents { ... }` of the arpero-shop Firestore rules.
    // To add Oscar's wife: put her Gmail in the list below and Publish.
    function familyMember() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['oskararpero@gmail.com' /*, 'wife@gmail.com' */];
    }
    match /families/arpero/{doc=**} {
      allow read, write: if familyMember();
    }
  }
}
